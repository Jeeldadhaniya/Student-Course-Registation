@model IEnumerable<StudentCourseRegistrationApp.Models.Student>

@{
    ViewData["Title"] = "Registered Students";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-primary mb-1">Student Course Registration</h1>
            <p class="text-muted mb-0">Browse and manage enrolled students and their course details.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                <i class="bi bi-person-plus-fill me-1"></i> + Register New Student
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold text-secondary">
                Enrolled Students List <span class="badge bg-secondary ms-2">@Model.Count()</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <p class="fs-5 mb-2">No students registered yet.</p>
                    <a asp-action="Create" class="btn btn-sm btn-outline-primary">Register the first student</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">ID</th>
                                <th scope="col">Student Name</th>
                                <th scope="col">Email Address</th>
                                <th scope="col">Course</th>
                                <th scope="col" class="text-center">Semester</th>
                                <th scope="col" class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">#@student.Id</td>
                                    <td class="fw-bold text-dark">@student.Name</td>
                                    <td class="text-muted">
                                        <a href="mailto:@student.Email" class="text-decoration-none text-secondary">@student.Email</a>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            @student.Course
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            Semester @student.Semester
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary px-3">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
